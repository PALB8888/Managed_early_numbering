managed implementation in class zbp_ea_mng_i_travel unique;
strict ( 2 );
with draft ;

define behavior for ZEA_MNG_I_TRAVEL //alias <alias_name>
persistent table ztravel_bodh
draft table ZTRAVEL_DFT_BODH
lock master
total etag LastChangedAt
authorization master ( instance )
early numbering
//etag master <field_name>
{
  create;
  update;
  delete;
  field ( readonly ) TravelId;
  association _Item { create; }

 draft action Resume;
draft action Edit;
draft action Activate;
draft action Discard;
draft determine action Prepare;




  mapping for ztravel_bodh
    {
      TravelId           = travel_id;
      AgencyId           = agency_id;
      CustomerId         = customer_id;
      BeginDate          = begin_date;
      Enddate            = end_date;
      BookingFee         = booking_fee;
      TotalPrice         = total_price;
      CurrencyCode       = currency_code;
      Description         = description;
      OverallStatus      = overall_status;
      CreatedBy          = created_by;
      createdAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = local_last_changed_at;
      LocalLastChangedAt = last_changed_at;
    }
}

define behavior for ZEA_MNG_I_BOOKING //alias <alias_name>
persistent table zbooking_bodh
draft table ZBOOKIG_DFT_BODH
lock dependent by _Header
early numbering
authorization dependent by _Header
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  association _Header;

    mapping for zbooking_bodh
    {
      TravelId           = travel_id;
      BookingId          = booking_id;
      BookingDate        = booking_date;
      CustomerId         = customer_id;
      CarrierId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      FlightPrice        = flight_price;
      CurrencyCode       = currency_code;
      BookingStatus      = booking_status;
      LocalLastChangedAt = local_last_changed_at;
    }


}