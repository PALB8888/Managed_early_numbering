projection;
strict ( 2 );
use draft;

define behavior for ZEA_MNG_P_TRAVEL //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; }
}

define behavior for ZEA_MNG_P_BOOKING //alias <alias_name>
{
  use update;
  use delete;

  use association _Header;
}